# ==============================================================================
# SMARTATHLETE PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Bu dosya yerel veya sunucu ortamında çalışırken gerekli olan gizli anahtarların
# ve bağlantı adreslerinin şablonudur. Gerçek üretim ortamında bu dosyanın adı
# '.env' olarak değiştirilmeli ve karşısındaki değerler doldurulmalıdır.

# 1. SUNUCU YAPILANDIRMASI
SERVER_PORT=8080
SERVER_ENVIRONMENT=production
DEBUG_MODE=false

# 2. FIREBASE BULUT BAĞLANTISI
FIREBASE_PROJECT_ID=smartathlete-performance-prod
