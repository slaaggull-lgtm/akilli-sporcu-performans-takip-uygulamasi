FIREBASE_DATABASE_URL=https://smartathlete-performance-prod.firebaseio.com

# 3. YANIT VE ANALİTİK MOTORU AYARLARI
PYTHON_ANALYTICS_WORKERS=4
MEDIAPIPE_MODEL_COMPLEXITY=2
TFLITE_QUANTIZATION_ACTIVE=true

# 4. GÜVENLİK VE ŞİFRELEME KEYLERİ
